# Docker Compose settings. Copy to .env (git-ignored) and fill in. Never commit .env.
# Generate a key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Use letters and digits only: the password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Optional
# POSTGRES_PORT=5432      # host port for the database, if 5432 is already in use
# LOG_LEVEL=INFO
# SEED_ON_START=true      # run seed_demo_users + import_data on every API start
